<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mid360_reliable_mapper</name>
  <version>0.1.0</version>
  <description>Real-flight edge mapping package for Livox MID360 with FAST-LIO2, reliable point cloud gating, occupancy grid mapping, and UAV mounting extrinsic TF.</description>
  <maintainer email="todo@example.com">MID360 Reliable Mapper</maintainer>
  <license>LGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>uf_sensor_pipeline</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
