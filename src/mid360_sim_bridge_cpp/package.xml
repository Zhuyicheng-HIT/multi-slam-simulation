<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mid360_sim_bridge_cpp</name>
  <version>0.1.0</version>
  <description>Direct Gazebo LaserScan to Livox CustomMsg adapter for MID360 simulation.</description>
  <maintainer email="2025111580@stu.hit.edu.cn">Yicheng Zhu</maintainer>
  <license>LGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-transport13</depend>
  <depend>livox_ros_driver2</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
