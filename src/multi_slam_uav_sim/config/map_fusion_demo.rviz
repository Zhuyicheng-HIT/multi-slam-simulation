Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map Products1
        - /Navigation1
      Splitter Ratio: 0.52
    Tree Height: 720
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.35
          Cell Size: 1
          Class: rviz_default_plugins/Grid
          Color: 95; 100; 105
          Enabled: true
          Line Style:
            Line Width: 0.03
            Value: Lines
          Name: Metric Grid
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 60
          Reference Frame: <Fixed Frame>
          Value: true
        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.6
          Name: Frames
          Show Arrows: true
          Show Axes: true
          Show Names: false
          Tree: {}
          Update Interval: 0
          Value: true
      Enabled: true
      Name: Reference
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.92
          Autocompute Intensity Bounds: true
          Axis: Z
          Channel Name: rgb
          Class: rviz_default_plugins/PointCloud2
          Color: 235; 235; 235
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Name: Online Shared Map
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.05
          Style: Flat Squares
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mapping/shared/points
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 205; 70
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Offline HybridFusion Result
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.045
          Style: Flat Squares
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /mapping/offline/fused
          Use Fixed Frame: true
          Value: true
      Enabled: true
      Name: Map Products
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 235; 220
          Enabled: true
          Head Diameter: 0.28
          Head Length: 0.2
          Length: 0.28
          Line Style: Lines
          Line Width: 0.05
          Name: Unified Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 0; 235; 220
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.08
          Shaft Length: 0.1
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /fusion/unified/path
          Value: true
        - Angle Tolerance: 0.05
          Class: rviz_default_plugins/Odometry
          Covariance:
            Orientation:
              Alpha: 0.25
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.18
              Color: 0; 235; 220
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 1
          Name: Unified Vehicle Pose
          Position Tolerance: 0.02
          Shape:
            Alpha: 1
            Axes Length: 0.65
            Axes Radius: 0.045
            Color: 0; 235; 220
            Head Length: 0.22
            Head Radius: 0.08
            Shaft Length: 0.45
            Shaft Radius: 0.035
            Value: Axes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /fusion/unified/odom
          Value: true
      Enabled: true
      Name: Navigation
  Enabled: true
  Global Options:
    Background Color: 10; 13; 17
    Fixed Frame: camera_init
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 210; 65
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 28
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Map Fusion View
      Near Clip Distance: 0.01
      Pitch: 0.92
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1500
  X: 80
  Y: 50
