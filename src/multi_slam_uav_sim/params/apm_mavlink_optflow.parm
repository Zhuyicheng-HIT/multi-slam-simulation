# Receive MAVLink optical flow through MAVROS, but keep GPS as the primary
# navigation source until a real rangefinder-to-FCU path is present.
EK3_SRC1_POSXY 3
EK3_SRC1_VELXY 3
EK3_SRC1_VELZ 0
FLOW_TYPE 5
RNGFND1_TYPE 1
RNGFND1_MIN 0
RNGFND1_MAX 40.00
RNGFND1_PIN 0
RNGFND1_SCALING 12.12
SIM_FLOW_ENABLE 0
