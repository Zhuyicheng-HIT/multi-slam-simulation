<?xml version="1.0"?>
<sdf version="1.10">
  <model name="mid360_3d_lidar_sensor_only">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="sensor_link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <visual name="mid360_body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.015 0.018 0.020 1</ambient>
          <diffuse>0.018 0.022 0.026 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <sensor name="mid360_sim_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/mid360/lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>40</samples>
              <resolution>1</resolution>
              <min_angle>-0.12217304764</min_angle>
              <max_angle>0.90757121104</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>40.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>
