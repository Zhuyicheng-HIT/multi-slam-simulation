    <link name="flow_camera_link">
      <pose>0.0 0.0 -0.35 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="optical_flow_mono_down" type="camera">
        <pose>0 0 0 0 1.57079632679 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/camera/camera</topic>
        <camera>
          <horizontal_fov>1.21126</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.105</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="flow_camera_mount_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>flow_camera_link</child>
    </joint>

    <!-- Front-facing D435i-style RGB-D camera. Gazebo camera +X is forward. -->
    <link name="front_d435i_link">
      <pose>0.30 0.0 0.02 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="d435i_body">
        <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <sensor name="front_d435i_rgbd" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/front/d435i/gz</topic>
        <camera>
          <horizontal_fov>1.21126</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.105</near><far>10.0</far></clip>
          <depth_camera><clip><near>0.105</near><far>10.0</far></clip></depth_camera>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.002</stddev></noise>
        </camera>
      </sensor>
      <sensor name="front_d435i_imu" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <topic>/front/d435i/gz/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="front_d435i_mount_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>front_d435i_link</child>
    </joint>

    <link name="mid360_link">
      <pose>0.0 0.0 0.0 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="mid360_body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.015 0.018 0.020 1</ambient>
          <diffuse>0.018 0.022 0.026 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <sensor name="mid360_sim_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/mid360/lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>40</samples>
              <resolution>1</resolution>
              <min_angle>-0.12217304764</min_angle>
              <max_angle>0.90757121104</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>40.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="mid360_mount_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>mid360_link</child>
    </joint>

    <!-- plugins -->
