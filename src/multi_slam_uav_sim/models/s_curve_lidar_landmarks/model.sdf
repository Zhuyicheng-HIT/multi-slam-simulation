<?xml version="1.0"?>
<sdf version="1.10">
  <model name="s_curve_lidar_landmarks">
    <static>true</static>
    <link name="landmarks">
      <!-- Collision-only landmarks preserve stage3 LiDAR observability without
           occluding the RGB scene stored in the frozen RTAB reference map. -->
      <collision name="west_south_slab">
