      <collision name="outer_south_column"><pose>0 -15.5 1.6 0 0 0</pose><geometry><cylinder><radius>0.58</radius><length>3.20</length></cylinder></geometry></collision>

      <collision name="outer_southeast_slab"><pose>14.8 -13.8 1.35 0 0 -0.58</pose><geometry><box><size>1.55 0.55 2.70</size></box></geometry></collision>

