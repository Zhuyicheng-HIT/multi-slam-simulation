    <!-- A separate low-altitude room keeps the legacy urban world intact while
         providing a controlled ceiling and nearby textured geometry. -->
    <model name="low_indoor_room">
      <static>true</static>
      <link name="room_geometry">
        <collision name="west_wall"><pose>-7.0 0 2.0 0 0 0</pose><geometry><box><size>0.25 14.0 4.0</size></box></geometry></collision>
        <visual name="west_wall_visual"><pose>-7.0 0 2.0 0 0 0</pose><geometry><box><size>0.25 14.0 4.0</size></box></geometry><material><ambient>0.22 0.30 0.42 1</ambient><diffuse>0.34 0.48 0.68 1</diffuse></material></visual>
