        <collision name="north_wall"><pose>0 7.0 2.0 0 0 0</pose><geometry><box><size>14.0 0.25 4.0</size></box></geometry></collision>
        <visual name="north_wall_visual"><pose>0 7.0 2.0 0 0 0</pose><geometry><box><size>14.0 0.25 4.0</size></box></geometry><material><ambient>0.28 0.40 0.28 1</ambient><diffuse>0.40 0.62 0.42 1</diffuse></material></visual>
        <collision name="south_wall"><pose>0 -7.0 2.0 0 0 0</pose><geometry><box><size>14.0 0.25 4.0</size></box></geometry></collision>
        <visual name="south_wall_visual"><pose>0 -7.0 2.0 0 0 0</pose><geometry><box><size>14.0 0.25 4.0</size></box></geometry><material><ambient>0.38 0.30 0.22 1</ambient><diffuse>0.62 0.48 0.34 1</diffuse></material></visual>
        <collision name="ceiling"><pose>0 0 4.0 0 0 0</pose><geometry><box><size>14.0 14.0 0.18</size></box></geometry></collision>
        <visual name="ceiling_visual"><pose>0 0 4.0 0 0 0</pose><geometry><box><size>14.0 14.0 0.18</size></box></geometry><material><ambient>0.30 0.32 0.36 1</ambient><diffuse>0.46 0.50 0.58 1</diffuse></material></visual>
        <!-- Small non-periodic reliefs provide close range facets without
             intersecting the low figure-eight centerline. -->
        <collision name="relief_a"><pose>-4.8 -3.0 0.55 0 0 0.18</pose><geometry><box><size>0.35 1.2 1.1</size></box></geometry></collision>
        <visual name="relief_a_visual"><pose>-4.8 -3.0 0.55 0 0 0.18</pose><geometry><box><size>0.35 1.2 1.1</size></box></geometry><material><ambient>0.88 0.18 0.08 1</ambient><diffuse>0.96 0.28 0.12 1</diffuse></material></visual>
        <collision name="relief_b"><pose>4.7 2.8 0.85 0 0 -0.30</pose><geometry><box><size>0.55 0.8 1.7</size></box></geometry></collision>
        <visual name="relief_b_visual"><pose>4.7 2.8 0.85 0 0 -0.30</pose><geometry><box><size>0.55 0.8 1.7</size></box></geometry><material><ambient>0.08 0.38 0.82 1</ambient><diffuse>0.10 0.52 0.94 1</diffuse></material></visual>
        <visual name="ceiling_marker"><pose>0 0 3.88 0 0 0</pose><geometry><box><size>2.2 0.10 0.03</size></box></geometry><material><ambient>0.90 0.78 0.08 1</ambient><diffuse>0.98 0.90 0.20 1</diffuse></material></visual>
