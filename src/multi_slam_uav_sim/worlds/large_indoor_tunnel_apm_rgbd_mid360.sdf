<?xml version="1.0"?>
<sdf version="1.10">
  <world name="large_indoor_tunnel">
    <physics name="apm_1ms_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.28 0.29 0.31 1</ambient>
      <background>0.08 0.09 0.11 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light name="tunnel_light" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.3 0.15 -0.94</direction>
      <diffuse>0.72 0.74 0.78 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
    </light>

    <model name="long_repetitive_tunnel">
      <static>true</static>
      <link name="tunnel_shell">
        <collision name="floor"><pose>0 0 -0.10 0 0 0</pose><geometry><box><size>8 96 0.20</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 -0.10 0 0 0</pose><geometry><box><size>8 96 0.20</size></box></geometry><material><diffuse>0.34 0.35 0.37 1</diffuse></material></visual>
        <collision name="west_wall"><pose>-4 0 2.5 0 0 0</pose><geometry><box><size>0.25 96 5</size></box></geometry></collision>
        <visual name="west_wall_visual"><pose>-4 0 2.5 0 0 0</pose><geometry><box><size>0.25 96 5</size></box></geometry><material><diffuse>0.42 0.43 0.46 1</diffuse></material></visual>
        <collision name="east_wall"><pose>4 0 2.5 0 0 0</pose><geometry><box><size>0.25 96 5</size></box></geometry></collision>
        <visual name="east_wall_visual"><pose>4 0 2.5 0 0 0</pose><geometry><box><size>0.25 96 5</size></box></geometry><material><diffuse>0.42 0.43 0.46 1</diffuse></material></visual>
        <collision name="roof"><pose>0 0 5.0 0 0 0</pose><geometry><box><size>8 96 0.20</size></box></geometry></collision>
        <visual name="roof_visual"><pose>0 0 5.0 0 0 0</pose><geometry><box><size>8 96 0.20</size></box></geometry><material><diffuse>0.28 0.29 0.31 1</diffuse></material></visual>

        <!-- Visual-only anchors: these thin overlays have no collision and
             therefore do not make the deliberately repetitive LiDAR geometry
             observable. Eight-metre texture tiles retain enough image-space
             gradient for the 100 px downward optical-flow camera. -->
        <visual name="floor_texture_m44"><pose>0 -44 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.78 0.80 0.82 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_m36"><pose>0 -36 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.80 0.78 0.74 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_m28"><pose>0 -28 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.74 0.80 0.78 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_m20"><pose>0 -20 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.78 0.76 0.82 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_m12"><pose>0 -12 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.82 0.78 0.76 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_m4"><pose>0 -4 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.76 0.82 0.78 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_p4"><pose>0 4 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.80 0.77 0.73 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_p12"><pose>0 12 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.74 0.79 0.83 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_p20"><pose>0 20 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.82 0.76 0.79 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_p28"><pose>0 28 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.77 0.82 0.74 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_p36"><pose>0 36 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.79 0.74 0.82 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>
        <visual name="floor_texture_p44"><pose>0 44 0.012 0 0 0</pose><geometry><box><size>7.7 7.8 0.012</size></box></geometry><material><diffuse>0.75 0.82 0.81 1</diffuse><pbr><metal><albedo_map>model://uav_test_assets/materials/textures/checker_floor.png</albedo_map><roughness>0.96</roughness></metal></pbr></material></visual>

        <!-- A continuous dashed centre line gives the downward camera a
             realistic lane-like anchor without adding range geometry. -->
        <visual name="lane_m42"><pose>0 -42 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_m36"><pose>0 -36 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_m30"><pose>0 -30 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_m24"><pose>0 -24 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_m18"><pose>0 -18 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_m12"><pose>0 -12 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_m6"><pose>0 -6 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_0"><pose>0 0 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_p6"><pose>0 6 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_p12"><pose>0 12 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_p18"><pose>0 18 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_p24"><pose>0 24 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_p30"><pose>0 30 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_p36"><pose>0 36 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>
        <visual name="lane_p42"><pose>0 42 0.024 0 0 0</pose><geometry><box><size>0.20 1.1 0.010</size></box></geometry><material><emissive>0.92 0.92 0.90 1</emissive></material></visual>

        <!-- Non-periodic wall panels provide RGB-D anchors. Their thin visual
             geometry stays inside the collision wall envelope. -->
        <visual name="west_anchor_m31"><pose>-3.866 -31.0 1.25 0 0 0</pose><geometry><box><size>0.012 1.30 1.10</size></box></geometry><material><emissive>0.72 0.16 0.12 1</emissive></material></visual>
        <visual name="east_anchor_m23"><pose>3.866 -23.0 2.85 0 0 0</pose><geometry><box><size>0.012 0.75 1.45</size></box></geometry><material><emissive>0.10 0.48 0.82 1</emissive></material></visual>
        <visual name="west_anchor_m14"><pose>-3.866 -14.0 3.35 0 0 0</pose><geometry><box><size>0.012 1.70 0.55</size></box></geometry><material><emissive>0.18 0.72 0.34 1</emissive></material></visual>
        <visual name="east_anchor_m7"><pose>3.866 -7.0 1.10 0 0 0</pose><geometry><box><size>0.012 0.62 1.75</size></box></geometry><material><emissive>0.88 0.54 0.10 1</emissive></material></visual>
        <visual name="west_anchor_p3"><pose>-3.866 3.0 2.30 0 0 0</pose><geometry><box><size>0.012 1.05 1.05</size></box></geometry><material><emissive>0.72 0.18 0.62 1</emissive></material></visual>
        <visual name="east_anchor_p11"><pose>3.866 11.0 3.55 0 0 0</pose><geometry><box><size>0.012 1.45 0.62</size></box></geometry><material><emissive>0.12 0.72 0.72 1</emissive></material></visual>
        <visual name="west_anchor_p19"><pose>-3.866 19.0 1.55 0 0 0</pose><geometry><box><size>0.012 0.72 1.55</size></box></geometry><material><emissive>0.86 0.30 0.12 1</emissive></material></visual>
        <visual name="east_anchor_p29"><pose>3.866 29.0 2.45 0 0 0</pose><geometry><box><size>0.012 1.85 0.70</size></box></geometry><material><emissive>0.30 0.62 0.18 1</emissive></material></visual>
        <visual name="west_anchor_p38"><pose>-3.866 38.0 3.05 0 0 0</pose><geometry><box><size>0.012 0.90 1.30</size></box></geometry><material><emissive>0.22 0.38 0.88 1</emissive></material></visual>

        <!-- Repeated ribs intentionally provide ambiguous along-tunnel geometry. -->
        <collision name="rib_m40"><pose>-3.80 -40 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_m40_visual"><pose>-3.80 -40 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_m30"><pose>-3.80 -30 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_m30_visual"><pose>-3.80 -30 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_m20"><pose>-3.80 -20 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_m20_visual"><pose>-3.80 -20 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_m10"><pose>-3.80 -10 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_m10_visual"><pose>-3.80 -10 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_0"><pose>-3.80 0 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_0_visual"><pose>-3.80 0 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_p10"><pose>-3.80 10 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_p10_visual"><pose>-3.80 10 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_p20"><pose>-3.80 20 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_p20_visual"><pose>-3.80 20 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_p30"><pose>-3.80 30 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_p30_visual"><pose>-3.80 30 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <collision name="rib_p40"><pose>-3.80 40 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry></collision>
        <visual name="rib_p40_visual"><pose>-3.80 40 2.5 0 0 0</pose><geometry><box><size>0.18 0.30 5</size></box></geometry><material><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>

        <!-- Sparse asymmetric end landmarks make recovery observable after the degenerate core. -->
        <collision name="south_landmark"><pose>-2.8 -43 1.1 0 0 0.35</pose><geometry><box><size>0.9 1.3 2.2</size></box></geometry></collision>
        <visual name="south_landmark_visual"><pose>-2.8 -43 1.1 0 0 0.35</pose><geometry><box><size>0.9 1.3 2.2</size></box></geometry><material><diffuse>0.78 0.18 0.12 1</diffuse></material></visual>
        <collision name="north_landmark"><pose>2.6 43 1.5 0 0 -0.28</pose><geometry><box><size>1.2 0.8 3.0</size></box></geometry></collision>
        <visual name="north_landmark_visual"><pose>2.6 43 1.5 0 0 -0.28</pose><geometry><box><size>1.2 0.8 3.0</size></box></geometry><material><diffuse>0.10 0.35 0.82 1</diffuse></material></visual>

        <!-- Repeated floor bands preserve optical flow while remaining longitudinally ambiguous. -->
        <visual name="band_m35"><pose>0 -35 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
        <visual name="band_m25"><pose>0 -25 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
        <visual name="band_m15"><pose>0 -15 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
        <visual name="band_m5"><pose>0 -5 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
        <visual name="band_p5"><pose>0 5 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
        <visual name="band_p15"><pose>0 15 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
        <visual name="band_p25"><pose>0 25 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
        <visual name="band_p35"><pose>0 35 0.015 0 0 0</pose><geometry><box><size>7.5 0.25 0.02</size></box></geometry><material><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <include><uri>model://textured_person</uri><name>tunnel_person_a</name><pose>-1.6 -24 0.05 0 0 0</pose></include>
    <include><uri>model://textured_person</uri><name>tunnel_person_b</name><pose>1.4 4 0.05 0 0 3.14159</pose></include>
    <include><uri>model://textured_person</uri><name>tunnel_person_c</name><pose>-1.2 28 0.05 0 0 0</pose></include>
    <include><uri>model://iris_apm_rgbd</uri><name>apm_iris</name><pose>0 0 0.50 0 0 0</pose></include>
  </world>
</sdf>
