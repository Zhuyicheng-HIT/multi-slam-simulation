<?xml version="1.0"?>
<sdf version="1.9">
  <world name="simple_uav_test">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.78 0.86 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.45 0.25 -0.86</direction>
      <diffuse>0.95 0.92 0.86 1</diffuse>
      <specular>0.35 0.35 0.32 1</specular>
    </light>

    <model name="textured_floor">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>40 40 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>40 40 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://simple_test_assets/materials/textures/checker_floor.png</albedo_map>
                <roughness>0.82</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="landing_pad_marker">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="pad_link">
        <visual name="pad_outer">
          <geometry>
            <cylinder>
              <radius>1.2</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="pad_inner">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.72</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.8 1</ambient>
            <diffuse>0.95 0.95 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="test_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="north_wall_collision">
          <pose>0 8 1.25 0 0 0</pose>
          <geometry><box><size>18 0.35 2.5</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 8 1.25 0 0 0</pose>
          <geometry><box><size>18 0.35 2.5</size></box></geometry>
          <material><ambient>0.62 0.66 0.68 1</ambient><diffuse>0.62 0.66 0.68 1</diffuse></material>
        </visual>

        <collision name="west_wall_collision">
          <pose>-8 -1 1.25 0 0 0</pose>
          <geometry><box><size>0.35 14 2.5</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-8 -1 1.25 0 0 0</pose>
          <geometry><box><size>0.35 14 2.5</size></box></geometry>
          <material><ambient>0.68 0.63 0.58 1</ambient><diffuse>0.68 0.63 0.58 1</diffuse></material>
        </visual>

        <collision name="short_wall_collision">
          <pose>5 -4 1.0 0 0 0.65</pose>
          <geometry><box><size>7 0.35 2.0</size></box></geometry>
        </collision>
        <visual name="short_wall_visual">
          <pose>5 -4 1.0 0 0 0.65</pose>
          <geometry><box><size>7 0.35 2.0</size></box></geometry>
          <material><ambient>0.45 0.55 0.62 1</ambient><diffuse>0.45 0.55 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="simple_obstacles">
      <static>true</static>
      <link name="obstacle_link">
        <collision name="box_1_collision">
          <pose>-3.5 3.2 0.6 0 0 0.25</pose>
          <geometry><box><size>1.8 1.2 1.2</size></box></geometry>
        </collision>
        <visual name="box_1_visual">
          <pose>-3.5 3.2 0.6 0 0 0.25</pose>
          <geometry><box><size>1.8 1.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>

        <collision name="box_2_collision">
          <pose>3.2 4.8 0.85 0 0 -0.3</pose>
          <geometry><box><size>1.2 2.0 1.7</size></box></geometry>
        </collision>
        <visual name="box_2_visual">
          <pose>3.2 4.8 0.85 0 0 -0.3</pose>
          <geometry><box><size>1.2 2.0 1.7</size></box></geometry>
          <material><ambient>0.35 0.48 0.5 1</ambient><diffuse>0.35 0.48 0.5 1</diffuse></material>
        </visual>

        <collision name="cylinder_collision">
          <pose>6 2 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="cylinder_visual">
          <pose>6 2 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.55</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.6 0.25 0.22 1</ambient><diffuse>0.6 0.25 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
