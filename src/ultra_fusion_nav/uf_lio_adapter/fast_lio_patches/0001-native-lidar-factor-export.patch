+void publish_native_lidar_factor()
+{
+    if (!native_factor_export_en || !pubNativeLidarFactor || !native_factor_msg.correspondences_valid)
+        return;
+
+    auto P = kf.get_P();
+    for (int i = 0; i < 6; i++)
+    {
+        int k = i < 3 ? i + 3 : i - 3;
+        for (int j = 0; j < 6; j++)
+        {
+            int l = j < 3 ? j + 3 : j - 3;
+            native_factor_msg.pose_covariance[i * 6 + j] = P(k, l);
+        }
+    }
+    native_factor_msg.header.stamp = get_ros_time(lidar_end_time);
+    pubNativeLidarFactor->publish(native_factor_msg);
+    native_factor_sequence++;
+}
