+void queue_backend_map_frame()
+{
+    PendingBackendMapFrame frame;
+    frame.stamp = lidar_end_time;
+    frame.points_lidar.reset(new PointCloudXYZI(*feats_down_body));
+    const M3D rotation = state_point.offset_R_L_I.toRotationMatrix();
+    const V3D translation = state_point.offset_T_L_I;
+    frame.frontend_position = {
+        state_point.pos(0), state_point.pos(1), state_point.pos(2)};
+    frame.frontend_quaternion_xyzw = {
+        state_point.rot.coeffs()[0], state_point.rot.coeffs()[1],
+        state_point.rot.coeffs()[2], state_point.rot.coeffs()[3]};
+    for (int row = 0; row < 3; ++row)
+    {
+        frame.lidar_to_body_translation[row] = translation(row);
+        for (int column = 0; column < 3; ++column)
+            frame.lidar_to_body_rotation[row * 3 + column] = rotation(row, column);
+    }
+    lock_guard<mutex> lock(backend_map_mutex);
+    pending_backend_map_frames.push_back(std::move(frame));
+    ++backend_map_frames_queued;
+    while (static_cast<int>(pending_backend_map_frames.size()) >
+           downstream_backend_max_pending_map_frames)
+    {
+        pending_backend_map_frames.pop_front();
+        ++backend_map_frames_dropped;
+    }
+}
+
+bool insert_backend_confirmed_frame(
+    const PendingBackendMapFrame &frame, const BackendMapPose &pose)
+{
+    Eigen::Quaterniond quaternion(
+        pose.quaternion_xyzw[3], pose.quaternion_xyzw[0],
+        pose.quaternion_xyzw[1], pose.quaternion_xyzw[2]);
+    if (quaternion.norm() <= 1.0e-12)
+        return false;
+    quaternion.normalize();
+    Eigen::Quaterniond frontend_quaternion(
+        frame.frontend_quaternion_xyzw[3], frame.frontend_quaternion_xyzw[0],
+        frame.frontend_quaternion_xyzw[1], frame.frontend_quaternion_xyzw[2]);
+    if (frontend_quaternion.norm() <= 1.0e-12)
+        return false;
+    frontend_quaternion.normalize();
+    const V3D frontend_position(
+        frame.frontend_position[0], frame.frontend_position[1],
+        frame.frontend_position[2]);
+    const V3D backend_position(
+        pose.position[0], pose.position[1], pose.position[2]);
+    const double translation_disagreement =
+        (backend_position - frontend_position).norm();
+    const double quaternion_dot = min(
+        1.0, max(0.0, fabs(quaternion.dot(frontend_quaternion))));
+    const double rotation_disagreement = 2.0 * acos(quaternion_dot);
+    if (translation_disagreement >
+            downstream_backend_max_map_translation_disagreement_m ||
+        rotation_disagreement >
+            downstream_backend_max_map_rotation_disagreement_rad)
+    {
+        ++backend_map_frames_rejected;
+        return false;
+    }
+    const M3D body_rotation = quaternion.toRotationMatrix();
+    const V3D body_position(
+        pose.position[0], pose.position[1], pose.position[2]);
+    M3D lidar_to_body_rotation;
+    V3D lidar_to_body_translation;
+    for (int row = 0; row < 3; ++row)
+    {
+        lidar_to_body_translation(row) = frame.lidar_to_body_translation[row];
+        for (int column = 0; column < 3; ++column)
+            lidar_to_body_rotation(row, column) =
+                frame.lidar_to_body_rotation[row * 3 + column];
+    }
+
+    PointVector points_world;
+    points_world.reserve(frame.points_lidar->size());
+    for (const auto &point_lidar : frame.points_lidar->points)
+    {
+        const V3D lidar_point(point_lidar.x, point_lidar.y, point_lidar.z);
+        const V3D world_point = body_rotation *
+            (lidar_to_body_rotation * lidar_point + lidar_to_body_translation)
+            + body_position;
+        PointType point = point_lidar;
+        point.x = world_point(0);
+        point.y = world_point(1);
+        point.z = world_point(2);
+        points_world.push_back(point);
+    }
+    const double started = omp_get_wtime();
+    add_point_size = ikdtree.Add_Points(points_world, true);
+    kdtree_incremental_time = omp_get_wtime() - started;
+    ++backend_map_frames_inserted;
+    if (backend_map_frames_inserted % 100 == 0)
+    {
+        cout << "Backend-confirmed map insertion: inserted="
+             << backend_map_frames_inserted << " rejected="
+             << backend_map_frames_rejected << " dropped="
+             << backend_map_frames_dropped << endl;
+    }
+    return true;
+}
+
+void apply_backend_confirmed_map_updates()
+{
+    vector<pair<PendingBackendMapFrame, BackendMapPose>> confirmed;
+    {
+        lock_guard<mutex> lock(backend_map_mutex);
+        while (!pending_backend_map_poses.empty())
+        {
+            const BackendMapPose pose = pending_backend_map_poses.front();
+            auto best = pending_backend_map_frames.end();
+            double best_delta = downstream_backend_state_tolerance_s;
+            for (auto it = pending_backend_map_frames.begin();
+                 it != pending_backend_map_frames.end(); ++it)
+            {
+                const double delta = fabs(it->stamp - pose.stamp);
+                if (delta <= best_delta)
+                {
+                    best = it;
+                    best_delta = delta;
+                }
+            }
+            if (best != pending_backend_map_frames.end())
+            {
+                confirmed.emplace_back(std::move(*best), pose);
+                pending_backend_map_frames.erase(best);
+                pending_backend_map_poses.pop_front();
+                continue;
+            }
+            if (!pending_backend_map_frames.empty() &&
+                pending_backend_map_frames.back().stamp >
+                    pose.stamp + downstream_backend_state_tolerance_s)
+            {
+                pending_backend_map_poses.pop_front();
+                ++backend_map_poses_unmatched;
+                continue;
+            }
+            break;
+        }
+    }
+    for (const auto &item : confirmed)
+        insert_backend_confirmed_frame(item.first, item.second);
+}
