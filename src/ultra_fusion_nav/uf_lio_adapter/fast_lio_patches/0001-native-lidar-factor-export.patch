new file mode 100755
index 0000000..e10cc3b
--- /dev/null
+++ b/msg/NativeLidarFactor.msg
@@ -0,0 +1,40 @@
+std_msgs/Header header
+
+# Identity of the linearized factor and coordinate frames.
+string source
+string map_frame
+string sensor_frame
+uint64 scan_sequence
+
+# The arrays below are row-major and use one row per accepted point-to-plane match.
+uint32 candidate_points
+uint32 matched_points
+uint32 jacobian_columns
+float64[3] linearization_position
+float64[4] linearization_quaternion
+
+# The pose above is map_T_body (FAST-LIO's IMU/body state). Points below are
+# expressed in sensor_frame; this transform is T_body_sensor.
+string state_frame
+string[] jacobian_state_order
+float64[3] lidar_to_body_translation
+float64[4] lidar_to_body_quaternion
+
+float64[] lidar_points_xyz
+float64[] plane_normals_xyz
+float64[] plane_points_xyz
+float64[] residuals
+
+# Optional per-point debug payload. It is empty by default; consumers must use
+# the raw geometry plus state_hessian/state_gradient for the runtime contract.
+float64[] jacobian
+
+# Unscaled normal matrix and gradient: H = J^T J, g = J^T r.
+float64[144] state_hessian
+float64[12] state_gradient
+float64 measurement_variance
+
+# FAST-LIO posterior pose covariance for diagnostics only; it is not measurement R.
+float64[36] pose_covariance
+bool approximate
+bool correspondences_valid
