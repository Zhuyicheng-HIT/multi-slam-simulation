+            }
+        }
+
+        VectorXd gradient = ekfom_data.h_x.transpose() * residual_vector;
+        for (int r = 0; r < 12; r++)
+        {
+            native_factor_msg.state_gradient[r] = gradient(r);
+            for (int c = 0; c < 12; c++)
