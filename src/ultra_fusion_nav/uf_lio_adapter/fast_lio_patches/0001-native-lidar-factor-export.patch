+            V3D norm_vec(norm_p.x, norm_p.y, norm_p.z);
+            double norm_sq = norm_vec.squaredNorm();
+            V3D plane_point = point_global;
+            if (norm_sq > 1e-12)
+                plane_point -= (static_cast<double>(norm_p.intensity) / norm_sq) * norm_vec;
+
+            native_factor_msg.lidar_points_xyz.push_back(laser_p.x);
+            native_factor_msg.lidar_points_xyz.push_back(laser_p.y);
+            native_factor_msg.lidar_points_xyz.push_back(laser_p.z);
+            native_factor_msg.plane_normals_xyz.push_back(norm_p.x);
+            native_factor_msg.plane_normals_xyz.push_back(norm_p.y);
+            native_factor_msg.plane_normals_xyz.push_back(norm_p.z);
+            native_factor_msg.plane_points_xyz.push_back(plane_point(0));
+            native_factor_msg.plane_points_xyz.push_back(plane_point(1));
