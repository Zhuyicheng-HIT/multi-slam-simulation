     rclcpp::shutdown();
 }
+void remove_body_envelope(PointCloudXYZI &cloud)
+{
+    if (!body_envelope_filter_en || cloud.empty())
+        return;
+
+    const auto first_removed = std::remove_if(
+        cloud.points.begin(), cloud.points.end(),
+        [](const PointType &point) {
+            const V3D point_lidar(point.x, point.y, point.z);
+            const V3D point_body =
+                Lidar_R_wrt_IMU * point_lidar + Lidar_T_wrt_IMU;
+            return point_body.x() >= body_envelope_min_x_m &&
+                point_body.x() <= body_envelope_max_x_m &&
+                point_body.y() >= body_envelope_min_y_m &&
+                point_body.y() <= body_envelope_max_y_m &&
+                point_body.z() >= body_envelope_min_z_m &&
+                point_body.z() <= body_envelope_max_z_m;
+        });
+    cloud.points.erase(first_removed, cloud.points.end());
+    cloud.width = static_cast<uint32_t>(cloud.points.size());
+    cloud.height = 1;
+}
