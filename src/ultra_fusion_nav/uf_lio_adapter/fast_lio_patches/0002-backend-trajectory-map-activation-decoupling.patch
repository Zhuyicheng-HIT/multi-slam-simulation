+    void publish_frontend_scan_request(bool retry)
+    {
+        if (!pub_frontend_scan_request_ || !Measures.lidar)
+            return;
+        fast_lio::msg::FrontendScanRequest request;
+        request.header.stamp = get_ros_time(lidar_end_time);
+        request.header.frame_id = "camera_init";
+        request.scan_sequence = native_factor_sequence;
+        request.scan_begin_stamp = get_ros_time(Measures.lidar_beg_time);
+        request.scan_end_stamp = get_ros_time(lidar_end_time);
+        request.map_frame = "camera_init";
+        request.body_frame = "body";
+        request.sensor_frame = native_factor_sensor_frame;
+        request.point_count = static_cast<uint32_t>(Measures.lidar->points.size());
+        pub_frontend_scan_request_->publish(request);
+        const double now_s = this->get_clock()->now().seconds();
+        backend_scan_request_last_publish_s_ = now_s;
+        if (!retry)
+        {
+            backend_scan_request_start_s_ = now_s;
+            backend_scan_timeout_reported_ = false;
+            ++backend_trajectory_initial_requests;
+        }
+        else
+        {
+            ++backend_trajectory_request_retries;
+        }
+        if (pub_frontend_scan_request_->get_subscription_count() == 0)
+            ++backend_trajectory_requests_without_subscriber;
+        ++backend_trajectory_requests;
+    }
