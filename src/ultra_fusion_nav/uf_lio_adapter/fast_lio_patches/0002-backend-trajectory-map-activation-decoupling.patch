 private:
+    void backend_activation_state_callback(
+        const nav_msgs::msg::Odometry::SharedPtr message)
+    {
+        ++backend_activation_states_received;
+        if (message->header.frame_id != "camera_init" ||
+            message->child_frame_id != "body")
+        {
+            ++backend_activation_states_rejected;
+            RCLCPP_WARN_THROTTLE(
+                this->get_logger(), *this->get_clock(), 5000,
+                "Ignoring backend trajectory activation state with frames %s -> %s",
+                message->header.frame_id.c_str(), message->child_frame_id.c_str());
+            return;
+        }
+        const auto &position = message->pose.pose.position;
+        const auto &orientation = message->pose.pose.orientation;
+        const double quaternion_norm = sqrt(
+            orientation.x * orientation.x + orientation.y * orientation.y +
+            orientation.z * orientation.z + orientation.w * orientation.w);
+        if (!isfinite(position.x) || !isfinite(position.y) ||
+            !isfinite(position.z) || !isfinite(quaternion_norm) ||
+            quaternion_norm <= 1.0e-12)
+        {
+            ++backend_activation_states_rejected;
+            return;
+        }
+        const bool was_seen = backend_state_seen.exchange(true);
+        if (!was_seen)
+        {
+            RCLCPP_INFO(
+                this->get_logger(),
+                "Backend trajectory activation state accepted on %s",
+                downstream_backend_activation_state_topic.c_str());
+        }
+    }
