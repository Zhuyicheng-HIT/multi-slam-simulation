+
+bool take_backend_trajectory(double begin_stamp, double end_stamp,
+    uint64_t sequence,
+    BackendDeskewTrajectoryRecord &output)
+{
+    lock_guard<mutex> lock(backend_trajectory_mutex);
+    auto best = pending_backend_trajectories.end();
+    for (auto it = pending_backend_trajectories.begin();
+         it != pending_backend_trajectories.end(); ++it)
+    {
+        if (it->sequence == sequence)
+        {
+            best = it;
+            break;
+        }
+    }
+    if (best == pending_backend_trajectories.end())
+        return false;
+    const double stamp_delta = fabs(best->end_stamp - end_stamp) +
+        fabs(best->begin_stamp - begin_stamp);
+    if (stamp_delta > 0.005)
+    {
+        ++backend_trajectories_time_mismatched;
+        pending_backend_trajectories.erase(best);
+        return false;
+    }
+    output = *best;
+    pending_backend_trajectories.erase(best);
+    return true;
+}
+
+void backend_deskew_trajectory_callback(
+    const fast_lio::msg::BackendDeskewTrajectory::SharedPtr message)
+{
+    ++backend_trajectories_received;
+    BackendDeskewTrajectoryRecord record;
+    record.begin_stamp = trajectory_stamp(message->scan_begin_stamp);
+    record.end_stamp = trajectory_stamp(message->scan_end_stamp);
+    record.sequence = message->scan_sequence;
+    record.reset_counter = message->reset_counter;
+    record.quality = message->quality;
+    record.valid = message->valid;
+    if (message->map_frame != "camera_init" || message->body_frame != "body" ||
+        record.begin_stamp <= 0.0 || record.end_stamp <= record.begin_stamp ||
+        record.begin_stamp > record.end_stamp)
+    {
+        ++backend_trajectories_contract_rejected;
+        return;
+    }
+    for (int i = 0; i < 3; ++i)
+    {
+        record.begin_position[i] = message->begin_position[i];
+        record.end_position[i] = message->end_position[i];
+    }
+    for (int i = 0; i < 4; ++i)
+    {
+        record.begin_orientation_xyzw[i] = message->begin_orientation_xyzw[i];
+        record.end_orientation_xyzw[i] = message->end_orientation_xyzw[i];
+    }
+    lock_guard<mutex> lock(backend_trajectory_mutex);
+    for (auto &pending : pending_backend_trajectories)
+    {
+        if (pending.sequence == record.sequence)
+        {
+            pending = record;
+            ++backend_trajectories_duplicate;
+            return;
+        }
+    }
+    pending_backend_trajectories.push_back(record);
+    ++backend_trajectories_queued;
+    while (pending_backend_trajectories.size() > 16)
+        pending_backend_trajectories.pop_front();
+}
+
+Eigen::Quaterniond trajectory_quaternion(
+    const std::array<double, 4> &coefficients)
+{
+    Eigen::Quaterniond quaternion(
+        coefficients[3], coefficients[0], coefficients[1], coefficients[2]);
+    if (quaternion.norm() <= 1.0e-12)
+        return Eigen::Quaterniond::Identity();
+    quaternion.normalize();
+    return quaternion;
+}
+
+bool undistort_with_backend_trajectory(
+    const BackendDeskewTrajectoryRecord &trajectory,
+    PointCloudXYZI &cloud)
+{
+    const double scan_duration = trajectory.end_stamp - trajectory.begin_stamp;
+    if (!trajectory.valid || scan_duration <= 1.0e-9)
+        return false;
+    const Eigen::Quaterniond begin_rotation =
+        trajectory_quaternion(trajectory.begin_orientation_xyzw);
+    const Eigen::Quaterniond end_rotation =
+        trajectory_quaternion(trajectory.end_orientation_xyzw);
+    const Eigen::Vector3d begin_position(
+        trajectory.begin_position[0], trajectory.begin_position[1],
+        trajectory.begin_position[2]);
+    const Eigen::Vector3d end_position(
+        trajectory.end_position[0], trajectory.end_position[1],
+        trajectory.end_position[2]);
+    for (auto &point : cloud.points)
+    {
+        const double alpha = min(1.0, max(0.0,
+            static_cast<double>(point.curvature) / 1000.0 / scan_duration));
+        const Eigen::Quaterniond rotation = begin_rotation.slerp(alpha, end_rotation);
+        const Eigen::Vector3d position =
+            (1.0 - alpha) * begin_position + alpha * end_position;
+        const Eigen::Vector3d point_sensor(point.x, point.y, point.z);
+        const Eigen::Vector3d point_body =
+            Lidar_R_wrt_IMU * point_sensor + Lidar_T_wrt_IMU;
+        const Eigen::Vector3d point_world = rotation * point_body + position;
+        const Eigen::Vector3d point_end_body =
+            end_rotation.conjugate() * (point_world - end_position);
+        const Eigen::Vector3d point_end_lidar =
+            Lidar_R_wrt_IMU.transpose() * point_end_body -
+            Lidar_R_wrt_IMU.transpose() * Lidar_T_wrt_IMU;
+        point.x = point_end_lidar.x();
+        point.y = point_end_lidar.y();
+        point.z = point_end_lidar.z();
+    }
+    return true;
+}
